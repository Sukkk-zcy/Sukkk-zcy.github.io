---
import links from '@/public/links.json'

import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import FriendList from '@/components/links/FriendList.astro'

const { friends } = links
const linkCategories = friends.filter(({ id_name }) => id_name !== 'inactive-links')
const activeLinks = linkCategories.reduce((total, group) => total + group.link_list.length, 0)

const meta = {
  title: '友链',
  description: '友好往来、持续阅读，以及互联网中的邻居。'
}
---

<PageLayout {meta}>
  <main class='links-page mt-6 lg:mt-10'>
    <KnowledgeIndexHero
      icon='link'
      eyebrow='Web neighborhood'
      title='友链'
      description='友好往来、持续阅读，以及互联网中的邻居。'
      stats={[
        { label: '收录站点', value: activeLinks }
      ]}
      statsLabel='链接统计'
      symbol='&#8734;'
    />

    <div class='links-stack animate'>
      {linkCategories.map((category) => (
        <section class='links-panel'>
          <header class='links-panel__header'>
            <span class='links-panel__icon' aria-hidden='true'>
              <Icon name='link' />
            </span>
            <div>
              <h2>友情链接</h2>
              <p>链接随机排序。</p>
            </div>
            <strong>{category.link_list.length}</strong>
          </header>
          <FriendList list={category} />
        </section>
      ))}
    </div>
  </main>
</PageLayout>

<style>
  .links-page {
    margin-inline: auto;
    width: min(100%, 70rem);
    padding-bottom: 4rem;
  }

  .links-stack {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.75rem;
  }

  .links-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    border: 1px solid hsl(var(--border) / 0.82);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 100% 0%, hsl(var(--primary) / 0.1), transparent 30%),
      linear-gradient(145deg, hsl(var(--muted) / 0.42), hsl(var(--background) / 0.58));
    box-shadow:
      inset 0 1px 0 hsl(var(--background) / 0.62),
      0 22px 50px -42px hsl(var(--foreground) / 0.45);
  }

  .links-panel__header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .links-panel__icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border: 1px solid hsl(var(--primary) / 0.18);
    border-radius: 0.85rem;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.09);
  }

  .links-panel__header h2 {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.2;
  }

  .links-panel__header p {
    margin: 0.28rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
  }

  .links-panel__header strong {
    margin-left: auto;
    color: hsl(var(--primary) / 0.64);
    font-family: var(--font-mono);
    font-size: 1.45rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .links-stack {
      margin-top: 1.5rem;
    }

    .links-panel {
      border-radius: 1.2rem;
    }
  }
</style>
