---
import type { MarkdownHeading } from 'astro'

import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import ContentPageHero from '@/components/pages/ContentPageHero.astro'

interface Props {
  title: string
  headings?: MarkdownHeading[]
  hideTitle?: boolean
  hideBack?: boolean
  mainClass?: string
  sidebarClass?: string
  layout?: 'document' | 'centered' | 'wide'
  eyebrow?: string
  description?: string
}

const {
  title,
  headings,
  hideTitle = false,
  hideBack = false,
  mainClass,
  sidebarClass,
  layout = 'document',
  eyebrow,
  description,
  ...props
} = Astro.props

const pageMode = layout === 'document' ? 'default' : layout

// Get current page slug from URL (reserved for future use)
// const currentSlug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '') || undefined
---

<PageLayout
  meta={{ title }}
  hideBack={hideBack}
  mainClass={mainClass}
  sidebarClass={sidebarClass}
  mode={pageMode}
  {...props}
>
  {layout === 'document' && headings?.length && <TOC headings={headings} slot='sidebar' />}

  {
    (
      <Fragment slot='header'>
        {!hideTitle && layout === 'document' && (
          <>
            <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>{title}</h1>
          </>
        )}
        {!hideTitle && layout !== 'document' && (
          <ContentPageHero {title} {eyebrow} {description} />
        )}
      </Fragment>
    )
  }

  <slot />

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
